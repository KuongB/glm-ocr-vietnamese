# ---------------------------------------------------------------------------
# Stage 1 - OCR endpoint (the GLM-OCR model deployed by ../serve.py)
# ---------------------------------------------------------------------------
OCR_API_URL=https://your-username--glm-ocr-api-ocr-endpoint.modal.run
OCR_API_TOKEN=

# ---------------------------------------------------------------------------
# Stage 2 - spelling-correction SLM endpoint
# Deploy serve_corrector.py, or point this at an endpoint you already host.
# ---------------------------------------------------------------------------
CORRECTOR_API_URL=https://your-username--vn-spell-correction-api-correct-endpoint.modal.run
CORRECTOR_API_TOKEN=
CORRECTOR_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# HTTP behaviour (both endpoints are serverless and cold-start slowly)
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT=120
MAX_RETRIES=3
CONCURRENCY=4

# ---------------------------------------------------------------------------
# Data layout (paths are relative to the annotation_pipeline folder)
# ---------------------------------------------------------------------------
IMAGES_DIR=data/images
MANIFEST_PATH=data/manifest.jsonl
EXPORT_DIR=data/export

# ---------------------------------------------------------------------------
# Stage 3 - review server
# ---------------------------------------------------------------------------
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8100
REVIEWER_NAME=reviewer
