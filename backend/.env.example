# Environment Configuration
APP_NAME=OCR Service API
VERSION=1.0.0
DEBUG=True

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Model Configuration (reference only, model runs on Modal)
HF_REPO_ID=KuongB/glm-ocr-vietnamese
MAX_IMAGE_SIZE=10485760

# Modal API Configuration (REQUIRED)
MODAL_API_URL=https://your-username--glm-ocr-api-ocr-endpoint.modal.run
MODAL_TOKEN=
MODAL_TIMEOUT=60
MODAL_MAX_RETRIES=3
